generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cairo", "cib", "misr", "nbe"]
}

model BANK1_CIB {
  id                Int                  @id @default(autoincrement())
  name              String
  email             String               @unique
  password          String
  customers         CUSTOMER[]
  financialProfiles FINANCIAL_PROFILES[]
  loanApplications  LOAN_APPLICATION[]
  loanHistories     LOAN_HISTORY[]
  transactions      TRANSACTION[]
  repayments        Rerepayment[]

  @@schema("cib")
}

model CUSTOMER {
  id                String               @id
  name              String
  age               Int
  email             String               @unique
  gender            String
  password          String
  monthly_income    Float
  employment_status String
  occupation        String
  education         String
  marital_status    String
  monthly_expenses  Float
  savings           Float
  existing_debt     Float
  city              String
  customer_since    DateTime
  bankId            Int
  bank              BANK1_CIB            @relation(fields: [bankId], references: [id])
  financialProfiles FINANCIAL_PROFILES[]
  loanApplications  LOAN_APPLICATION[]
  loanHistories     LOAN_HISTORY[]
  transactions      TRANSACTION[]
  repayments        Rerepayment[]

  @@schema("cib")
}

model FINANCIAL_PROFILES {
  avg_monthly_income                  Float
  estimated_monthly_transaction_spend Float
  top_spending_category               String
  savings_to_income_ratio             Float
  debt_to_income_ratio                Float
  financial_health_band               String
  bankId                              Int
  customerId                          String
  bank                                BANK1_CIB @relation(fields: [bankId], references: [id])
  customer                            CUSTOMER  @relation(fields: [customerId], references: [id])

  @@id([customerId, bankId])
  @@schema("cib")
}

model LOAN_APPLICATION {
  application_id         String         @id
  requested_loan_amount  Float
  loan_duration_months   Int
  monthly_income         Float
  monthly_expenses       Float
  savings                Float
  existing_debt          Float
  debt_to_income_ratio   Float
  employment_status      String
  previous_late_payments Boolean
  default_status         Boolean
  bankId                 Int
  customerId             String
  bank                   BANK1_CIB      @relation(fields: [bankId], references: [id])
  customer               CUSTOMER       @relation(fields: [customerId], references: [id])
  loanHistories          LOAN_HISTORY[]

  @@schema("cib")
}

model LOAN_HISTORY {
  loan_id              String           @id
  loan_amount          Float
  loan_duration_months Int
  interest_rate_pct    Float
  monthly_installment  Float
  late_payments        Int
  default_status       Boolean
  application_id       String
  bankId               Int
  customerId           String
  application          LOAN_APPLICATION @relation(fields: [application_id], references: [application_id])
  bank                 BANK1_CIB        @relation(fields: [bankId], references: [id])
  customer             CUSTOMER         @relation(fields: [customerId], references: [id])
  repayments           Rerepayment[]

  @@schema("cib")
}

model Rerepayment {
  repayment_id       String       @id
  installment_number Int
  due_date           DateTime
  payment_date       DateTime?
  installment_amount Float
  payment_status     String
  loan_id            String
  bankId             Int
  customerId         String
  bank               BANK1_CIB    @relation(fields: [bankId], references: [id])
  customer           CUSTOMER     @relation(fields: [customerId], references: [id])
  loan               LOAN_HISTORY @relation(fields: [loan_id], references: [loan_id])

  @@map("rerepayment")
  @@schema("cib")
}

model TRANSACTION {
  transaction_id            String    @id
  transaction_date          DateTime
  amount                    Float
  category                  String
  transaction_type          String
  balance_after_transaction Float
  bankId                    Int
  customerId                String
  bank                      BANK1_CIB @relation(fields: [bankId], references: [id])
  customer                  CUSTOMER  @relation(fields: [customerId], references: [id])

  @@schema("cib")
}

